<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cleaner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0E17</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Cleaner.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0E17</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#14B8A6</item>
        <item name="postSplashScreenTheme">@style/Theme.Cleaner</item>
    </style>
</resources>
